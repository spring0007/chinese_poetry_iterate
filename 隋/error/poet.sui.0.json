[

 {

  "author": "佚名",

  "paragraphs": [

   "崇基负海，建国□□。遗□后嗣，留爱于足。兴王启霸，世属功臣。",

   "攀龙矫足，高蹈燕秦。美矣高□，华哉盛族。荣庆必隆，挺兹岳牧。",

   "无遗两□，有荣五服。负石沉江，嗽流岩谷。公之诞嗣，荫□荣荣。",

   "承家主奠，实二高明。敦崇礼让，修拭身名。诗骚散志，风月吟情。",

   "冽□□朝，位隆二国。吏仰其威，足思其德。卷舒图史，遨游儒墨。",

   "道□南容，□逾□北。方城刺举，求瘼帷褰。衢奔竹马，水涸贪泉。",

   "慈仁孝悌，公亦有焉。九皋□响，声闻于天。梁木横□，太山其颓。",

   "哲人萎矣，呜呼哀哉。悲风满□，愁云□开。泪将花堕，鸟共声哀。",

   "素车同萃，白马俱来。挂剑空存，悬□徒在。□返北城，□旋南海。",

   "芳林欲正，□风无改。孝子欲养，慈亲不在。"

  ],

  "title": "大隋仪同三司建州刺史故徐君墓志铭",

  "id": "fc3bcd8d-b1d5-4b2f-8b68-d45978be198c",

  "dynasty": "隋",

  "authorId": "e1052798-23d4-45a4-ad13-a2e58d47551f",

  "genreId": 6

 },

 {

  "author": "佚名",

  "paragraphs": [

   "屹然孤坟，南阜之墩。殒我慈母，苍天不仁。涧水夜流，松烟昼昏。",

   "□□涟洏，暮暮晨晨。"

  ],

  "title": "隋故太原王夫人墓志铭",

  "id": "736f7ba7-bf83-4f4b-bce6-42812ae6c060",

  "dynasty": "隋",

  "authorId": "e1052798-23d4-45a4-ad13-a2e58d47551f",

  "genreId": 6

 },

 {
  "author": "佚名",
  "paragraphs": [
   "襄阳白铜蹄。郎杀荆州儿。"
  ],
  "title": "元徽中童谣",
  "id": "55a9c106-64e6-4eda-9d33-748c4b855016",
  "dynasty": "隋",
  "authorId": "e1052798-23d4-45a4-ad13-a2e58d47551f",
  "genreId": 1
 },

 {
  "author": "佚名",
  "paragraphs": [
   "不畏萧娘与吕姥。但畏合肥有韦武。"
  ],
  "title": "北军为韦睿歌",
  "id": "0227365a-a1f6-42b6-aeb7-0ba476bb79a0",
  "dynasty": "隋",
  "authorId": "e1052798-23d4-45a4-ad13-a2e58d47551f",
  "genreId": 1
 },

 {
  "author": "佚名",
  "paragraphs": [
   "月明光光星欲堕。欲来不来早语我。"
  ],
  "title": "地驱乐歌",
  "id": "b3bb1748-28fe-4216-9644-966a2c3120cb",
  "dynasty": "隋",
  "authorId": "e1052798-23d4-45a4-ad13-a2e58d47551f",
  "genreId": 1
 },

 {
  "author": "佚名",
  "paragraphs": [
   "图官在乱世，觅富在荒年。"
  ],
  "title": "徐陵引谚",
  "id": "b7218d98-03cf-4799-8fab-fa1899bf1e9b",
  "dynasty": "隋",
  "authorId": "e1052798-23d4-45a4-ad13-a2e58d47551f",
  "genreId": 1
 },

 {
  "author": "佚名",
  "paragraphs": [
   "青丝白马寿阳来。"
  ],
  "title": "普通中童谣",
  "id": "d96a93c2-f5c8-4ed9-b80d-e06fbd17cfec",
  "dynasty": "隋",
  "authorId": "e1052798-23d4-45a4-ad13-a2e58d47551f",
  "genreId": 1
 },

 {
  "author": "佚名",
  "paragraphs": [
   "一日不书。百事荒芜。"
  ],
  "title": "李彪引谚",
  "id": "7e202f45-3861-4b22-8a53-bdafbb4a236a",
  "dynasty": "隋",
  "authorId": "e1052798-23d4-45a4-ad13-a2e58d47551f",
  "genreId": 1
 },

 {
  "author": "佚名",
  "paragraphs": [
   "不畏张弓拔刀。唯畏白堕春醪。"
  ],
  "title": "杨衒之引游侠语",
  "id": "47c376ba-3398-49d6-ad20-41c65b0c5937",
  "dynasty": "隋",
  "authorId": "e1052798-23d4-45a4-ad13-a2e58d47551f",
  "genreId": 1
 },

 {
  "author": "佚名",
  "paragraphs": [
   "快马健儿。不如老妪吹篪。"
  ],
  "title": "杨衒之引秦民语",
  "id": "2c1a628b-5d42-424d-9baa-a9e4ad92ddba",
  "dynasty": "隋",
  "authorId": "e1052798-23d4-45a4-ad13-a2e58d47551f",
  "genreId": 1
 },

 {
  "author": "佚名",
  "paragraphs": [
   "狐截尾。你欲除我我除你。"
  ],
  "title": "武平元年童谣",
  "id": "bd846cb7-634a-440f-8f1b-d9004a0972be",
  "dynasty": "隋",
  "authorId": "e1052798-23d4-45a4-ad13-a2e58d47551f",
  "genreId": 1
 },

 {
  "author": "佚名",
  "paragraphs": [
   "名军大将莫自牢。千兵万马避白袍。"
  ],
  "title": "洛阳童谣",
  "id": "a7332125-5243-413a-bdd6-0242c0d30d3e",
  "dynasty": "隋",
  "authorId": "e1052798-23d4-45a4-ad13-a2e58d47551f",
  "genreId": 1
 },

 {
  "author": "佚名",
  "paragraphs": [
   "昭潭无底橘洲浮。"
  ],
  "title": "郦道元引橘洲谚",
  "id": "2dfe55f2-665d-4c12-96a9-69ff14d84c20",
  "dynasty": "隋",
  "authorId": "e1052798-23d4-45a4-ad13-a2e58d47551f",
  "genreId": 1
 },

 {
  "author": "佚名",
  "paragraphs": [
   "车前女子年十五。手弹琵琶玉节舞。"
  ],
  "title": "钜鹿公主歌辞 其二",
  "id": "771128ba-1381-4e8d-a9f4-7265b56fc0fe",
  "dynasty": "隋",
  "authorId": "e1052798-23d4-45a4-ad13-a2e58d47551f",
  "genreId": 1
 },

 {
  "author": "佚名",
  "paragraphs": [
   "尺牍书疏，千里面目。"
  ],
  "title": "颜之推引江南谚论书法",
  "id": "7f7b6960-d37e-4071-b33b-e80f31c15bcc",
  "dynasty": "隋",
  "authorId": "e1052798-23d4-45a4-ad13-a2e58d47551f",
  "genreId": 1
 },

 {
  "author": "佚名",
  "paragraphs": [
   "其益如毫。其损如刀。"
  ],
  "title": "高允引谚",
  "id": "34270ee0-f874-4b7e-99e3-13ad0b088b95",
  "dynasty": "隋",
  "authorId": "e1052798-23d4-45a4-ad13-a2e58d47551f",
